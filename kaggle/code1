        return "❌ 抽帧自检异常：%s" % str(e)[:100]
    finally:
        shutil.rmtree(d, ignore_errors=True)


if __name__ == "__main__":
    print(capabilities(), time.strftime("%H:%M:%S"))
    print(selftest())
