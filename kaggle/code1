  <span id="st" class="pill">连接中…</span><span id="gpu" class="pill"></span>
  <span style="flex:1"></span>
  <a href="/crawl" id="crawlbtn" style="order:99;text-decoration:none;background:#10b981;color:#052e1f;font-weight:700;border-radius:8px;padding:7px 14px;font-size:13px">🕸️ 自动爬取并审查网络照片</a>
  <label>模式 <select id="mode"><option value="full">完整(大模型描述)</option><option value="fast">快速(仅分类器)</option></select></label>
</header>
<main>
  <div id="drop"><div style="font-size:34px">📥</div><div><b>拖拽图片或文件夹到这里</b>，或点击选择（数量不限，也可 Ctrl+V 粘贴）</div></div>
  <input id="file" type="file" accept="image/*" multiple hidden>
  <div class="bar">
    <div class="prog"><i id="pg"></i></div><span id="cnt">0 / 0</span>
    <button data-f="all" class="pri">全部</button><button data-f="pass">通过</button><button data-f="review">待复核</button><button data-f="block">拦截</button>
    <button id="csv">导出 CSV</button><button id="xlsx" style="background:#16a34a;border-color:#16a34a;color:#fff;font-weight:700" title="含缩略图、涉政/涉黄/暴力等违规类别、汇总">📊 生成 Excel</button><button id="clr">清空</button>
  </div>
  <div id="grid"></div>
</main>
<script>
const $=s=>document.querySelector(s);
const items=[];let filter="all",conc=2,running=0,done=0;
const VT={pass:"✅ 通过",review:"⚠️ 待复核",block:"🚫 拦截",pending:"⏳ 排队中",error:"❌ 失败"};
async function health(){try{const h=await (await fetch("/api/health")).json();
 $("#st").textContent=h.ready?"GPU 就绪 · "+h.replicas_ready+" 副本":(h.status==="error"?"加载失败":"模型加载中…");
 $("#st").className="pill "+(h.ready?"ok":h.status==="error"?"bad":"warn");
 $("#gpu").textContent=(h.gpu_stats&&h.gpu_stats.length?h.gpu_stats.map(g=>"GPU"+g.index+(g.busy?"●":"○")+(g.mem_used_gb!=null?" "+g.mem_used_gb+"/"+g.mem_total_gb+"G":"")+(g.vlm?" "+g.vlm.split("/").pop():"")).join(" | "):(h.gpus||[]).map(g=>g.name).join(" + "))+(h.avg_ms?" · 均 "+h.avg_ms+"ms":"");
 conc=Math.max(2,Math.min(8,(h.replicas||1)*2));}catch(e){$("#st").textContent="未连接";$("#st").className="pill bad"}}
setInterval(health,4000);health();
function shrink(file,max=1280){return new Promise(res=>{const u=URL.createObjectURL(file);const im=new Image();
 im.onload=()=>{const r=Math.min(1,max/Math.max(im.width,im.height));const c=document.createElement("canvas");c.width=Math.round(im.width*r);c.height=Math.round(im.height*r);
  c.getContext("2d").drawImage(im,0,0,c.width,c.height);c.toBlob(b=>res({blob:b||file,url:u}),"image/jpeg",.88)};
 im.onerror=()=>res({blob:file,url:u});im.src=u})}
function add(files){for(const f of files){if(!f.type.startsWith("image/"))continue;const it={file:f,state:"pending",id:items.length};items.push(it);}render();pump()}
async function pump(){while(running<conc){const it=items.find(x=>x.state==="pending");if(!it)break;it.state="running";running++;run(it).finally(()=>{running--;pump()})}}
async function run(it){try{const s=await shrink(it.file);it.url=s.url;it.blob=s.blob;render1(it);
 const fd=new FormData();fd.append("file",s.blob,it.file.name);fd.append("mode",$("#mode").value);
 let r=await fetch("/api/analyze",{method:"POST",body:fd});
 for(let i=0;i<20&&r.status===503;i++){await new Promise(r=>setTimeout(r,3000));r=await fetch("/api/analyze",{method:"POST",body:fd})}
 if(!r.ok)throw new Error((await r.json().catch(()=>({}))).detail||r.status);
 it.res=await r.json();it.state="done"}catch(e){it.state="error";it.err=String(e.message||e)}
 done++;render1(it);prog()}
function prog(){const n=items.length;const d=items.filter(i=>i.state==="done"||i.state==="error").length;$("#cnt").textContent=d+" / "+n;$("#pg").style.width=(n?d/n*100:0)+"%"}
function vkey(it){return it.state==="done"?it.res.verdict:it.state==="error"?"error":"pending"}
function boxes(r){if(!r||!r.detections)return"";return r.detections.filter(d=>d.kind!=="text"||d.flag).map(d=>{const b=d.box;if(!b)return"";
 return `<div class="bx ${d.flag?"f":d.kind==="text"?"t":""}" style="left:${b[0]*100}%;top:${b[1]*100}%;width:${(b[2]-b[0])*100}%;height:${(b[3]-b[1])*100}%">${d.flag||d.kind!=="text"?`<i>${esc(d.cn||d.label)}</i>`:""}</div>`}).join("")}
function chips(r){const c=[];const cnt={};(r.detections||[]).filter(d=>d.kind==="object"||d.kind==="nude").forEach(d=>{const k=(d.flag?"⚠":"")+d.cn;cnt[k]=(cnt[k]||0)+1});
 for(const k in cnt)c.push(`<span class="chip ${k[0]==="⚠"?"f":""}">${esc(k)}${cnt[k]>1?"×"+cnt[k]:""}</span>`);
 if(r.aux){if(r.aux.qr&&r.aux.qr.length)c.push(`<span class="chip f">二维码×${r.aux.qr.length}</span>`);(r.aux.contacts||[]).slice(0,3).forEach(x=>c.push(`<span class="chip f">${esc(x)}</span>`));if(r.aux.faces)c.push(`<span class="chip">人脸×${r.aux.faces}</span>`)}
 return c.join("")}
function html(it){const k=vkey(it);const r=it.res;return `<div class="ph"><img src="${it.url||""}" loading="lazy">${boxes(r)}</div><div class="b"><span class="tag ${k==="error"?"block":k}">${VT[k]}</span>
 <div class="fn" title="${esc(it.file.name)}">${esc(it.file.name)}</div>${r?`<div class="d">${esc(r.description||"")}</div><div class="d">涉黄 ${(r.porn.score*100).toFixed(0)}% · 涉政 ${(r.political.score*100).toFixed(0)}%${r.violence?" · 暴力 "+(r.violence.score*100).toFixed(0)+"%":""}</div>${chips(r)}${r.reasons.map(x=>`<div class="d" style="color:#fbbf24">${esc(x)}</div>`).join("")}${r.ocr_text?`<div class="d" style="color:#7d8ab0">文字：${esc(r.ocr_text.slice(0,80))}</div>`:""}`:it.err?`<div class="d">${esc(it.err)}</div>`:""}</div>`}
function esc(s){return String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]))}
function render1(it){let el=document.getElementById("c"+it.id);if(!el){render();return}el.innerHTML=html(it);vis(el,it)}
function vis(el,it){el.style.display=(filter==="all"||filter===vkey(it))?"":"none"}
function render(){const g=$("#grid");g.innerHTML="";for(const it of items){const el=document.createElement("div");el.className="card";el.id="c"+it.id;el.innerHTML=html(it);vis(el,it);g.appendChild(el)}prog()}
async function walk(entry,out){if(entry.isFile){await new Promise(r=>entry.file(f=>{out.push(f);r()},r))}else if(entry.isDirectory){const rd=entry.createReader();let all=[];while(true){const b=await new Promise(r=>rd.readEntries(r,()=>r([])));if(!b.length)break;all=all.concat(b)}for(const e of all)await walk(e,out)}}
const drop=$("#drop");drop.onclick=()=>$("#file").click();$("#file").onchange=e=>{add([...e.target.files]);e.target.value=""};
["dragenter","dragover"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add("on")}));
["dragleave","drop"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove("on")}));
addEventListener("dragover",e=>e.preventDefault());
addEventListener("drop",async e=>{e.preventDefault();const out=[];const its=[...e.dataTransfer.items||[]];
 if(its.length&&its[0].webkitGetAsEntry){const es=its.map(i=>i.webkitGetAsEntry()).filter(Boolean);for(const en of es)await walk(en,out)}else out.push(...e.dataTransfer.files);add(out)});
addEventListener("paste",e=>{const fs=[...(e.clipboardData?.files||[])];if(fs.length)add(fs)});
document.querySelectorAll("button[data-f]").forEach(b=>b.onclick=()=>{filter=b.dataset.f;document.querySelectorAll("button[data-f]").forEach(x=>x.classList.toggle("pri",x===b));items.forEach(it=>{const el=document.getElementById("c"+it.id);if(el)vis(el,it)})});
$("#clr").onclick=()=>{items.length=0;render()};
$("#csv").onclick=()=>{const rows=[["文件名","结论","涉黄分","涉政分","暴力分","描述","原因","图中文字"]];for(const it of items){const r=it.res;rows.push([it.file.name,vkey(it),r?r.porn.score:"",r?r.political.score:"",r&&r.violence?r.violence.score:"",r?r.description:it.err||"",r?r.reasons.join("; "):"",r?r.ocr_text||"":""])}
 const t="\ufeff"+rows.map(r=>r.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(",")).join("\n");const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([t],{type:"text/csv"}));a.download="审查结果.csv";a.click()};

function thumb(it){return new Promise(res=>{const src=it.blob||it.file;if(!src){res(null);return}const u=URL.createObjectURL(src);const im=new Image();
 im.onload=()=>{const r=Math.min(1,320/Math.max(im.width,im.height));const c=document.createElement("canvas");c.width=Math.max(1,Math.round(im.width*r));c.height=Math.max(1,Math.round(im.height*r));
  c.getContext("2d").drawImage(im,0,0,c.width,c.height);const d=c.toDataURL("image/jpeg",.8);URL.revokeObjectURL(u);res(d)};
 im.onerror=()=>{URL.revokeObjectURL(u);res(null)};im.src=u})}
$("#xlsx").onclick=async()=>{const done=items.filter(i=>i.state==="done"||i.state==="error");if(!done.length){alert("还没有审核结果");return}
 const b=$("#xlsx"),t=b.textContent;b.disabled=true;b.textContent="生成中…";
 try{const rows=[];let n=0;for(const it of done){rows.push({idx:++n,kind:"upload",name:it.file.name,res:it.res||null,err:it.err||"",image:await thumb(it)})}
  const r=await fetch("/api/export/xlsx",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({title:"图片智能审查报告",rows})});
  if(!r.ok){const j=await r.json().catch(()=>({}));throw new Error(j.detail||("HTTP "+r.status))}
  const blob=await r.blob();const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="图片审核报告-"+new Date().toISOString().slice(0,10)+".xlsx";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),3000)}
 catch(e){alert("生成 Excel 失败："+(e.message||e))}b.disabled=false;b.textContent=t};
</script>
</body>
</html>
