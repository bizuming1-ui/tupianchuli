    """违规类别（与前端 src/lib/excel.ts 的 categoriesOf 规则一致）"""
    if not res:
        return []
    out: List[str] = []
    porn = (res.get("porn") or {}).get("level")
    pol = (res.get("political") or {}).get("level")
    vio = (res.get("violence") or {}).get("level")
