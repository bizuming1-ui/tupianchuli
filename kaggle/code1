def sh(cmd, tail=1200):
    print(">>", cmd)
    p = subprocess.run(cmd, shell=True, text=True, capture_output=True)
    out = ((p.stdout or "") + (p.stderr or "")).strip()
    if out:
        print(out[-tail:])
    return p.returncode

def have(mod):
    try:
        importlib.invalidate_caches()
        importlib.import_module(mod)
